#
# system_ext props for joan
#

# DPM
persist.vendor.dpm.feature=11

# Logging
debug.vendor.sns.daemon=0
debug.vendor.sns.libsensor1=0
persist.vendor.debug.sensors.hal=0
persist.log.tag.SDM=WARNING

# Media volume: finer steps on the Quad DAC (AudioService + libaudiopolicymanagercustom)
ro.config.media_vol_fine=true
